# Server configuration. Copy to .env.local; never commit populated secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Node 24, persistent local disk. Optional absolute data directory:
DATA_DIR=
SUPPORT_EMAIL=

# Default text routing: Groq, then Gemini. Configure your own eligible accounts.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional official text providers; free quotas depend on the account.
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Disabled by default. Zen free access returned client-only 403 in this audit.
OPENCODE_API_KEY=
ENABLE_ZEN_API=false
# Developer evaluation endpoint; review terms before use.
NVIDIA_NIM_API_KEY=
ENABLE_NVIDIA_TRIAL=false
# Existing third-party integration: unverified, never a default dependency.
APINEX_API_KEY=
ENABLE_APINEX=false
ENABLE_DIAGNOSTICS=false

# Optional payments. No fake/test top-ups when these are absent.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Supabase supplies Google identity. Enable Google in Supabase and allow the callback URL.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional key slots: replace the provider prefix as needed, up to _6.
# These are authorised credentials, not additional provider/project quotas.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
# Only true behind a proxy that overwrites client-supplied forwarding headers.
TRUST_PROXY_HEADERS=false

# Local defaults. For split hosting see DEPLOY.md.
APP_ROLE=all
DATA_BACKEND=sqlite
MONGODB_URI=
MONGODB_DATABASE=syaahi
WORKER_MODE=embedded
BACKEND_URL=
BACKEND_PROXY_SECRET=

# Comma-separated account UUIDs, set only on the backend.
SUPPORT_ADMIN_IDS=
