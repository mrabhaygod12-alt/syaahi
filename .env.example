# Server configuration. Copy to .env.local; never commit populated secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional runtime authentication/CSRF origin for the backend. Use the exact public origin.
APP_ORIGIN=
# Node 24, persistent local disk. Optional absolute data directory:
DATA_DIR=
SUPPORT_EMAIL=

# Default text routing: Groq, then Gemini. Configure your own eligible accounts.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional official text providers; free quotas depend on the account.
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Zen: set ENABLE_ZEN_API=true for eligible accounts; prior free access was client-only.
OPENCODE_API_KEY=
ENABLE_ZEN_API=false
# Developer evaluation endpoint; review terms before use.
NVIDIA_NIM_API_KEY=
ENABLE_NVIDIA_TRIAL=false
# APInex: set ENABLE_APINEX=true only after account/access verification.
APINEX_API_KEY=
ENABLE_APINEX=false
ENABLE_DIAGNOSTICS=false

# Optional payments. No fake/test top-ups when these are absent.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Monthly Razorpay plan IDs from the same account/mode as the key pair.
RAZORPAY_PLAN_STARTER_INR=
RAZORPAY_PLAN_PRO_INR=
RAZORPAY_PLAN_MAX_INR=
# Render API only; international currency orders stay disabled until approved.
# After Razorpay confirms multi-currency checkout, set e.g. INR,USD,EUR.
RAZORPAY_SUPPORTED_CURRENCIES=INR

# Supabase supplies Google identity. Enable Google in Supabase and allow the callback URL.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional key slots: replace the provider prefix as needed, up to _6.
# These are authorised credentials, not additional provider/project quotas.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
# Only true behind a proxy that overwrites client-supplied forwarding headers.
TRUST_PROXY_HEADERS=false
# Only for a custom ingress that appends exactly this many hops and blocks direct access.
TRUSTED_PROXY_HOPS=1
# Isolated PDF child processes per API instance; 1 is recommended on small hosts (max 2).
PDF_MAX_CONCURRENT=1

# Local defaults. For split hosting see DEPLOY.md.
APP_ROLE=all
DATA_BACKEND=sqlite
MONGODB_URI=
MONGODB_DATABASE=syaahi
WORKER_MODE=embedded
BACKEND_URL=
BACKEND_PROXY_SECRET=

# Comma-separated account UUIDs, set only on the backend.
SUPPORT_ADMIN_IDS=
# Explicit bootstrap administrators. Stored roles can override these permissions.
ADMIN_EMAILS=
# 32 random bytes, base64 encoded. Keep stable and server-only. When omitted,
# a backend proxy secret of at least 32 characters is used to derive the key.
ADMIN_MFA_KEY=
# Production always requires MFA; this flag also enforces it in development.
ADMIN_MFA_ENFORCE=0

# Verified email referrals: Resend key and an authenticated sender domain.
RESEND_API_KEY=
EMAIL_FROM=

# Bounded worker capacity (raise only after measuring provider quota and memory)
WORKER_CONCURRENCY=2
PAGE_CONCURRENCY=2
MAX_ACTIVE_JOBS_PER_USER=3
MONGO_POOL_SIZE=20
# Public YouTube caption-less fallback requires a compatible Gemini model/key.
ENABLE_YOUTUBE_VIDEO_FALLBACK=true
GEMINI_VIDEO_MODEL=gemini-3.8-flash

# Direct UPI Payment System
# Receiving QRs are verified in lib/billing/upi-merchants.ts; legacy UPI_MERCHANT_* variables are unused.
# Account IDs allowed to approve money received (separate from support roles)
PAYMENT_ADMIN_IDS=

# Optional third-party gateways: enable only after reviewing data policy and account budget.
# Up to four authorized credentials TOTAL: API_KEY_1 through API_KEY_4 (or base key + 3 slots).
# Keys belonging to one account share that account's quota. 429 never rotates to evade a limit.
ENABLE_AIHUBMIX=false
AIHUBMIX_API_KEY_1=
AIHUBMIX_API_KEY_2=
AIHUBMIX_API_KEY_3=
AIHUBMIX_API_KEY_4=
AIHUBMIX_MODELS=
AIHUBMIX_MAX_CONTEXT=8192
ENABLE_UNOROUTER=false
UNOROUTER_API_KEY_1=
UNOROUTER_API_KEY_2=
UNOROUTER_API_KEY_3=
UNOROUTER_API_KEY_4=
UNOROUTER_MODELS=
UNOROUTER_MAX_CONTEXT=8192
ENABLE_RADOX=false
RADOX_API_KEY_1=
RADOX_API_KEY_2=
RADOX_API_KEY_3=
RADOX_API_KEY_4=
RADOX_MODELS=
RADOX_MAX_CONTEXT=8192
# Logfare documents one active regular key. Premium access can require training consent.
ENABLE_LOGFARE=false
LOGFARE_API_KEY=
LOGFARE_MODELS=
LOGFARE_MAX_CONTEXT=8192
LOGFARE_DATA_POLICY_ACK=false
# Antseed is your own gateway, not antseedstats.com or the marketing website.
ENABLE_ANTSEED=false
ANTSEED_BASE_URL=
ANTSEED_API_KEY_1=
ANTSEED_API_KEY_2=
ANTSEED_API_KEY_3=
ANTSEED_API_KEY_4=
ANTSEED_MODELS=
ANTSEED_MAX_CONTEXT=8192
